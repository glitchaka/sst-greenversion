// SST Green visual theme. Change colors here, not in GUI components.
// Defined as a Slint global to support runtime theme substitution.
export global GreenPalette {
    // Fonts are theme values; component source never chooses a font family.
    in-out property <string> heading-font: "Oxanium";
    in-out property <string> interface-font: "Oxanium";
    in-out property <string> background-fit: "cover";
    in-out property <color> heading-outline: rgb(168, 156, 136);
